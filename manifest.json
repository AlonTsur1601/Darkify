{
  "manifest_version": 3,
  "name": "Darkify",
  "version": "1.2.1",
  "description": "Forces a natural-looking dark mode on light websites while preserving images and leaving already-dark sites untouched.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16_v3.png",
      "32": "icons/icon32_v3.png",
      "48": "icons/icon48_v3.png",
      "128": "icons/icon128_v3.png"
    }
  },
  "icons": {
    "16": "icons/icon16_v3.png",
    "32": "icons/icon32_v3.png",
    "48": "icons/icon48_v3.png",
    "128": "icons/icon128_v3.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["dark.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
